{
    "name": "code-to-visualization/laravel-response-trace",
    "description": "Opt-in JsonResource response tracing for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/auth": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "CodeToVisualization\\ResponseTrace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeToVisualization\\ResponseTrace\\Examples\\": "examples/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeToVisualization\\ResponseTrace\\ResponseTraceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
